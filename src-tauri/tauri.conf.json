{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "T-Minus",
  "version": "0.1.1",
  "identifier": "com.furyspace21.tminus",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "T-Minus",
        "width": 820,
        "height": 860,
        "minWidth": 560,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "FurySpace21",
    "copyright": "© 2026 FurySpace21",
    "shortDescription": "T-Minus",
    "longDescription": "A minimal countdown with configurable periods.",
    "licenseFile": "../LICENSE.txt",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "template": "nsis/installer.nsi",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
